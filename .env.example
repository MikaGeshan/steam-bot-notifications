NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://steam_bot:steam_bot@localhost:5432/steam_bot
DATABASE_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Supabase Server
# Isi nilai sebenarnya hanya di .env/secret manager, jangan commit secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Gunakan mock provider agar aplikasi dapat dicoba tanpa kredensial eksternal.
USE_MOCK_PROVIDERS=true

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_BOT_USERNAME=

# Steam
STEAM_WEB_API_KEY=
STEAM_OPENID_REALM=http://localhost:3000

# IsThereAnyDeal
ITAD_API_KEY=

# Internal API/admin
INTERNAL_API_KEY=local-internal-key
ADMIN_API_KEY=local-admin-key
LINK_TOKEN_SECRET=replace-with-at-least-32-characters
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Scheduler
PRICE_REFRESH_MINUTES=60
STEAM_SYNC_HOURS=24
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
