{
  "name": "steam-discount-notifications",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "scheduler": "bun src/scheduler.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun test tests/integration/repository.integration.ts",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@supabase/server": "1.6.1",
    "elysia": "1.4.30",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
